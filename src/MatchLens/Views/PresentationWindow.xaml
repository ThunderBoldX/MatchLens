<Window x:Class="MatchLens.PresentationWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:MatchLens" Title="{DynamicResource Loc.41}" WindowStyle="None" ResizeMode="NoResize" ShowActivated="False" ShowInTaskbar="False" Focusable="False" Width="1280" Height="900" Left="-32000" Top="-32000" WindowStartupLocation="Manual">
 <local:RoundedPanel CornerRadius="26" Background="{StaticResource Bg}" BorderBrush="{StaticResource GlassEdge}" BorderThickness="1">
  <Grid>
   <Ellipse Width="1100" Height="650" Fill="#145A3875" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-420,-420,0,0" IsHitTestVisible="False"><Ellipse.Effect><BlurEffect Radius="90"/></Ellipse.Effect></Ellipse>
   <Grid Margin="32,24,32,20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid Margin="0,0,0,24"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel Orientation="Horizontal"><local:LensMark Width="52" Height="52" Margin="0,0,16,0"/><StackPanel VerticalAlignment="Center"><TextBlock Text="M A T C H L E N S" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="MatchMeta" FontSize="13" Foreground="{StaticResource Muted}" Margin="0,5,0,0"/></StackPanel></StackPanel>
     <Border Grid.Column="1" CornerRadius="22" BorderBrush="#50A63DFF" BorderThickness="1" Background="#10A63DFF" Padding="18,10" VerticalAlignment="Center" Margin="18,0,0,0"><TextBlock x:Name="LiveLabel" FontSize="13" Foreground="#DDBBFF"/></Border>
    </Grid>
    <ScrollViewer x:Name="StatisticsScroll" Grid.Row="1" Focusable="False" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False">
     <StackPanel>
      <Border Style="{StaticResource GlassCard}" Padding="24,19" Margin="0,0,0,24"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <StackPanel><TextBlock Text="{DynamicResource Loc.42}" FontSize="11" Foreground="{StaticResource Muted}"/><TextBlock x:Name="SelfSummary" FontSize="24" FontWeight="Medium" Margin="0,8,0,0"/><TextBlock x:Name="SelfDetail" FontSize="13" Foreground="{StaticResource Muted}" Margin="0,7,0,0"/></StackPanel>
       <Border Grid.Column="1" Width="1" Background="#14FFFFFF" Margin="0,0,18,0"/>
       <StackPanel Grid.Column="2"><TextBlock Text="{DynamicResource Loc.43}" FontSize="11" Foreground="{StaticResource Muted}"/><TextBlock x:Name="ThreatSummary" FontSize="20" FontWeight="Medium" Margin="0,8,0,0"/><TextBlock x:Name="ThreatDetail" FontSize="13" Foreground="{StaticResource Muted}" Margin="0,7,0,0"/></StackPanel>
      </Grid></Border>
      <Grid Margin="0,0,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="{DynamicResource Loc.44}" FontSize="22" FontWeight="Medium"/><TextBlock x:Name="RosterCount" Grid.Column="1" Foreground="{StaticResource Muted}" FontSize="13" VerticalAlignment="Center"/></Grid>
      <TextBlock x:Name="EmptyLabel" Text="{DynamicResource Loc.45}" FontSize="18" Foreground="{StaticResource Muted}" Margin="0,16,0,30"/>
      <UniformGrid x:Name="PlayerGrid" Columns="2"/>
      <TextBlock Text="{DynamicResource Loc.46}" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,12,12,16"/>
     </StackPanel>
    </ScrollViewer>
    <Grid Grid.Row="2" Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="WheelHint" Text="{DynamicResource Loc.47}" FontSize="12" Foreground="{StaticResource Muted}"/><TextBlock x:Name="ScrollHint" Grid.Column="1" FontSize="12" Foreground="{StaticResource Muted}" Margin="16,0,0,0"/></Grid>
   </Grid>
  </Grid>
 </local:RoundedPanel>
</Window>

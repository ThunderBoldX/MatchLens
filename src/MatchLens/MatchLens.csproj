<Project Sdk="Microsoft.NET.Sdk">
 <PropertyGroup>
  <OutputType>WinExe</OutputType><TargetFramework>net10.0-windows</TargetFramework>
  <UseWPF>true</UseWPF><UseWindowsForms>true</UseWindowsForms><Nullable>enable</Nullable><ImplicitUsings>disable</ImplicitUsings>
  <PlatformTarget>x64</PlatformTarget><AssemblyName>MatchLens</AssemblyName><Version>0.4.9</Version>
  <ApplicationManifest>app.manifest</ApplicationManifest><RestoreIgnoreFailedSources>true</RestoreIgnoreFailedSources>
  <ApplicationIcon>Assets\MatchLens.ico</ApplicationIcon>
  <AppHostDotNetSearch Condition="'$(PortableRuntime)'=='true'">AppRelative</AppHostDotNetSearch>
  <AppHostRelativeDotNet Condition="'$(PortableRuntime)'=='true'">..\runtime</AppHostRelativeDotNet>
  <!-- WPF owns startup and DPI; Windows Forms is used only for the tray. -->
  <NoWarn>$(NoWarn);WFO0003</NoWarn>
 </PropertyGroup>
 <ItemGroup><FrameworkReference Include="Microsoft.AspNetCore.App"/></ItemGroup>
 <ItemGroup><PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47"/></ItemGroup>
 <ItemGroup><None Update="Dependencies\MicrosoftEdgeWebview2Setup.exe" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"/></ItemGroup>
 <ItemGroup><Resource Include="Assets\MatchLens-logo.png"/><Resource Include="Assets\MatchLens.ico"/></ItemGroup>
 <ItemGroup><Resource Include="Assets\Leetify-badge.png"/></ItemGroup>
 <ItemGroup><EmbeddedResource Include="Localization\en.json" LogicalName="MatchLens.Localization.en.json"/></ItemGroup>
 <ItemGroup><EmbeddedResource Include="Localization\ui.json" LogicalName="MatchLens.Localization.ui.json"/></ItemGroup>
</Project>
